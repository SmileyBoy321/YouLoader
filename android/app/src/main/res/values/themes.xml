<resources>
    <style name="Theme.YouLoader" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="materialCardViewStyle">@style/Widget.YouLoader.Card</item>
    </style>

    <style name="Widget.YouLoader.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Small caps section labels, like FORMAT and QUALITY on Windows. -->
    <style name="TextAppearance.YouLoader.Label" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/muted</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="Widget.YouLoader.GhostButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/card_border</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- MP3 / MP4: the chosen one gets the accent outline and text, like the Windows format cards. -->
    <style name="Widget.YouLoader.FormatButton" parent="Widget.YouLoader.GhostButton">
        <item name="strokeColor">@color/format_stroke</item>
        <item name="android:textColor">@color/format_text</item>
        <item name="backgroundTint">@color/format_fill</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.YouLoader.LinkButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
