<Window x:Class="YouLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouLoader" Width="800" Height="800" MinWidth="640" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="Assets/youloader.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display"
        xmlns:local="clr-namespace:YouLoader">
    <Window.Resources>
        <local:AtLeastConverter x:Key="AtLeast" />
    </Window.Resources>
    <!-- Normally the page fills the window and only the download list scrolls. When the window is too short
         for that (small laptop screens), the page keeps a minimum height and the whole window scrolls instead,
         so the download list is never squeezed out of view. -->
    <ScrollViewer x:Name="PageScroll" Padding="24,20,24,14" Focusable="False"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Height="{Binding ViewportHeight, ElementName=PageScroll, Converter={StaticResource AtLeast}, ConverterParameter=720}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,16">
            <Image Source="Assets/logo.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="YouLoader" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Free forever · No ads · No tracking" Foreground="{StaticResource Muted}" FontSize="13" />
            </StackPanel>
        </DockPanel>

        <!-- App update notice -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource AccentSoft}"
                BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Get it" Style="{StaticResource GhostButton}" Click="GetUpdate_Click" />
                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Link, format and destination -->
        <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="14" Padding="18">
            <StackPanel>
                <!-- Grows with the links in it (about six lines) before it starts to scroll -->
                <Grid>
                    <TextBox x:Name="UrlBox" Style="{StaticResource FieldBox}" MinHeight="58" MaxHeight="168" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" TextChanged="UrlBox_TextChanged" PreviewKeyDown="UrlBox_PreviewKeyDown"
                             AutomationProperties.Name="Links to download" />
                    <TextBlock x:Name="UrlPlaceholder" IsHitTestVisible="False" Margin="12,9,12,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}"
                               Text="Paste YouTube links here. One per line, or a whole playlist." />
                </Grid>
                <DockPanel Margin="2,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Paste" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Paste_Click" />
                    <Button x:Name="ClearLinksButton" DockPanel.Dock="Right" Content="Clear" Style="{StaticResource GhostButton}"
                            Click="ClearLinks_Click" Visibility="Collapsed" />
                    <TextBlock x:Name="LinkCount" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <Border x:Name="NoticeBar" Visibility="Collapsed" Margin="0,10,0,0" Padding="12,8" CornerRadius="8"
                        Background="#1D212A" BorderBrush="#3A404C" BorderThickness="1">
                    <DockPanel>
                        <TextBlock Text="ⓘ" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="13" />
                    </DockPanel>
                </Border>

                <TextBlock Text="FORMAT" Style="{StaticResource Label}" Margin="2,16,0,8" />
                <WrapPanel x:Name="FormatPanel">
                    <RadioButton Style="{StaticResource Chip}" GroupName="format" Tag="Mp3" Checked="Format_Checked">
                        <TextBlock><Run Text="MP3" FontWeight="SemiBold" /><Run Text="  audio · plays everywhere" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" GroupName="format" Tag="Mp4" Checked="Format_Checked">
                        <TextBlock><Run Text="MP4" FontWeight="SemiBold" /><Run Text="  video" /></TextBlock>
                    </RadioButton>
                </WrapPanel>
                <TextBlock x:Name="FormatHint" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="2,0,0,0" />

                <TextBlock Text="QUALITY" Style="{StaticResource Label}" Margin="2,16,0,8" />
                <WrapPanel x:Name="QualityPanel" />
                <TextBlock x:Name="QualityHint" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="2,0,0,10" />

                <WrapPanel Margin="2,6,0,0">
                    <CheckBox x:Name="PlaylistBox" Content="Whole playlist when a video link has one" Margin="0,0,24,6"
                              ToolTip="Playlist and channel links always download everything into their own folder." />
                    <CheckBox x:Name="EmbedArtBox" Content="Embed cover art &amp; tags" Margin="0,0,0,6" />
                </WrapPanel>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock Text="SAVE TO" Style="{StaticResource Label}" />
                        <TextBlock x:Name="OutputText" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Change…" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ChangeFolder_Click" />
                    <Button Grid.Column="2" Content="Open" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OpenFolder_Click" />
                    <Button x:Name="DownloadButton" Grid.Column="3" Style="{StaticResource AccentButton}" Margin="16,0,0,0"
                            IsEnabled="False" Click="Download_Click" ToolTip="Enter. Use Shift+Enter for a new line.">
                        <TextBlock Text="Download" FontSize="15" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Queue header -->
        <DockPanel Grid.Row="3" Margin="2,20,0,8">
            <Button DockPanel.Dock="Right" Content="Clear finished" Style="{StaticResource LinkButton}" Click="ClearFinished_Click" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DOWNLOADS" Style="{StaticResource Label}" VerticalAlignment="Center" />
                <TextBlock x:Name="QueueSummary" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Queue -->
        <Grid Grid.Row="4">
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{StaticResource Muted}" LineHeight="22">
                Nothing here yet.<LineBreak />Paste a link above and press Enter.
            </TextBlock>
            <ScrollViewer x:Name="QueueScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="QueueList" ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Padding="14,12" Margin="0,0,0,8" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Card}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Background="{StaticResource Field}" CornerRadius="5" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormatLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
                                    </DockPanel>

                                    <ProgressBar Grid.Row="1" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,10,0,6">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Processing">
                                                        <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Done">
                                                        <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Canceled">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>

                                    <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="Cancel_Click"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Click="Why_Click" Margin="0,0,6,0"
                                                Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                    <Setter Property="Content" Value="Why?" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowExplanation}" Value="True">
                                                            <Setter Property="Content" Value="Hide" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Retry" Style="{StaticResource GhostButton}" Click="Retry_Click"
                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="▶  Play" Style="{StaticResource GhostButton}" Click="Play_Click" Margin="0,0,6,0"
                                                Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Show" Style="{StaticResource GhostButton}" Click="Show_Click"
                                                Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <!-- The answer to "why did this fail?", shown inside the item -->
                                    <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="14,12" CornerRadius="10"
                                            Background="{StaticResource Field}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                            Visibility="{Binding ShowExplanation, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="WHAT HAPPENED" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding Error.Cause}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,12" />
                                            <TextBlock Text="WHAT YOU CAN TRY" Style="{StaticResource Label}" />
                                            <ItemsControl ItemsSource="{Binding Error.Suggestions}" Margin="0,4,0,6" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,2">
                                                            <TextBlock Text="•" Foreground="{StaticResource Accent}" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="20" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <DockPanel Margin="0,6,0,0">
                                                <Button DockPanel.Dock="Right" Content="Report a problem" Style="{StaticResource LinkButton}"
                                                        Margin="14,0,0,0" Click="Report_Click" />
                                                <Button DockPanel.Dock="Right" Content="Copy details" Style="{StaticResource LinkButton}"
                                                        Margin="14,0,0,0" Click="CopyDetails_Click"
                                                        Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BoolToVisibility}}" />
                                                <Button HorizontalAlignment="Left" Click="ToggleDetails_Click"
                                                        Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BoolToVisibility}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                            <Setter Property="Content" Value="Show technical details ▾" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowTechnicalDetails}" Value="True">
                                                                    <Setter Property="Content" Value="Hide technical details ▴" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DockPanel>
                                            <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource FieldBox}"
                                                     FontFamily="Cascadia Mono, Consolas" FontSize="11.5" MaxHeight="180" Margin="0,8,0,0"
                                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                     AutomationProperties.Name="Technical details"
                                                     Visibility="{Binding ShowTechnicalDetails, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="5" Margin="2,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="UpdateToolsButton" Content="Update yt-dlp" Style="{StaticResource LinkButton}" Click="UpdateTools_Click" />
                <TextBlock Text="  ·  " Foreground="{StaticResource Muted}" FontSize="12" />
                <Button Content="Source code" Style="{StaticResource LinkButton}" Click="Source_Click" />
            </StackPanel>
            <TextBlock x:Name="ToolStatus" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Text="Getting ready…" />
        </DockPanel>
    </Grid>
    </ScrollViewer>
</Window>
