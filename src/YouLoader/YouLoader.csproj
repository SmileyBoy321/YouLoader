<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\youloader.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Product>YouLoader</Product>
    <Description>Free, ad-free YouTube and SoundCloud downloader for Opus, MP3 and MP4.</Description>
    <Copyright>Copyright (c) SmileyBoy</Copyright>
  </PropertyGroup>

  <!-- dotnet publish -c Release  ->  one portable YouLoader.exe that needs nothing installed -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\youloader.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YouLoader.Core\YouLoader.Core.csproj" />
  </ItemGroup>

</Project>
