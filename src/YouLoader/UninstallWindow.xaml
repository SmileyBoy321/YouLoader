<Window x:Class="YouLoader.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall YouLoader" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="Assets/youloader.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14" TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,24,28,26">

        <!-- Step 1: what will be removed -->
        <StackPanel x:Name="ConfirmPanel">
            <DockPanel Margin="0,0,0,18">
                <Image Source="Assets/logo.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Uninstall YouLoader?" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Everything YouLoader put on this PC will be removed." Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="WHAT GETS REMOVED" Style="{StaticResource Label}" Margin="2,0,0,8" />
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,4">
                <StackPanel>
                    <ItemsControl x:Name="Rows" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,11">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Foreground="{StaticResource Muted}"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,11">
                        <TextBlock x:Name="TotalText" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource Accent}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="13" />
                        <TextBlock Text="Space freed" FontWeight="SemiBold" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Reassurance: downloads are never touched -->
            <Border Background="#11261B" BorderBrush="#2E7D4F" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,14,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Success}" VerticalAlignment="Top" Margin="0,1,12,0">
                        <Path Data="M 6 11.5 L 9.6 15 L 16.5 7.5" Stroke="#0F1115" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Your music and videos stay" FontWeight="SemiBold" />
                        <TextBlock x:Name="KeptText" Foreground="#A9D8BB" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="KeepButton" Content="Keep YouLoader" Style="{StaticResource GhostButton}" Padding="18,9"
                        IsCancel="True" IsDefault="True" Click="Keep_Click" />
                <Button x:Name="UninstallButton" Content="Uninstall" Style="{StaticResource AccentButton}" Margin="10,0,0,0"
                        Click="Uninstall_Click" />
            </StackPanel>
        </StackPanel>

        <!-- Step 2: done -->
        <StackPanel x:Name="DonePanel" Visibility="Collapsed" Margin="0,12,0,4">
            <Border Width="72" Height="72" CornerRadius="36" Background="#11261B" BorderBrush="#2E7D4F" BorderThickness="1.5" HorizontalAlignment="Center">
                <Path Data="M 22 37 L 31.5 46.5 L 51 26" Stroke="{StaticResource Success}" StrokeThickness="4.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Border>
            <TextBlock Text="YouLoader has been removed" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0" />
            <TextBlock x:Name="DoneText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" MaxWidth="420" Margin="0,6,0,0" LineHeight="21" />
            <TextBlock x:Name="FailedText" Foreground="{StaticResource Danger}" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" MaxWidth="440" Margin="0,12,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <Button Content="Open my downloads" Style="{StaticResource GhostButton}" Padding="16,9" Click="OpenDownloads_Click" />
                <Button x:Name="CloseButton" Content="Close" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
